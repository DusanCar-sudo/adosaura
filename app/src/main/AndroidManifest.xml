<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The drawer is built from a file, but we still resolve each package's
         real label and launchable activity, so we need to see the app list. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- /sdcard/adosaura/{apps,layout}.conf live in shared storage so they can
         be edited over adb and from a file manager. Granted with
         `appops set dev.aura.adosaura MANAGE_EXTERNAL_STORAGE allow`
         (see scripts/adb-grants.sh); the launcher degrades gracefully without it. -->
    <!-- The app switcher needs usage stats to read the MRU list without root,
         and process killing to implement the clean action. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Open-Meteo weather tile needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The weather tile asks for the phone's last known coarse fix; without it
         it falls back to the look file and then to IP geolocation. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The lock screen overlay will need to start on boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Adosaura">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Adosaura"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by the edge swipe-down over any app. Its own affinity so
             closing it returns to that app, not to the home screen. -->
        <activity
            android:name=".switcher.SwitcherActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="dev.aura.adosaura.switcher"
            android:theme="@style/Theme.Adosaura.Overlay" />

        <!-- Full-swipe control: right edge Back, left edge Forward, down for
             the switcher. Enabled by scripts/adb-grants.sh. -->
        <service
            android:name=".gestures.EdgeService"
            android:exported="true"
            android:label="@string/edge_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/edge_service" />
        </service>
    </application>

</manifest>
